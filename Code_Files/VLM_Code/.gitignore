cat > .gitignore << 'EOF'
# Environment variables (NEVER commit API keys!)
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Model weights (large files)
*.pth
*.pt
*.ckpt

# Data directories (usually too large for git)
Dataset/
Masks_Batches_Dataset/
New_Depth_Dataset/
PothRGBD_Dataset/
*.zip
data/

# VLM outputs (generated files)
Code_Files/VLM_Code/data/vlm_outputs/
Code_Files/VLM_Code/data/final_assessments/

# OS
.DS_Store
Thumbs.db
EOF